# Environment for the test suites (node --test via `npm run test:unit`, Japa via `node ace test`).
# Placeholder values only: nothing here is a secret, and no test connects to the database or Redis.
NODE_ENV=test
PORT=3333
HOST=127.0.0.1
URL=http://127.0.0.1:3333
LOG_LEVEL=silent
APP_KEY=test-only-app-key-not-a-secret-0000000000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nomad_test
DB_PASSWORD=nomad_test
DB_DATABASE=nomad_test
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
